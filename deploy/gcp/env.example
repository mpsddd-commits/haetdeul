# GCP VM 의 /srv/haetdeul/.env 로 복사해 값을 채운다 (git 에 올리지 않는다).
#   sudo install -m 600 -o $USER deploy/gcp/env.example /srv/haetdeul/.env
#
# compose.yml 의 `${X:?...}` 항목은 비어 있으면 docker compose 가 거부한다.
# ★ DB 가 아직 없으면 DB_* 에 임시값(예: DB_HOST=not-ready)을 넣어 두면 된다 —
#   화면과 /health 는 뜨고, DB 를 쓰는 API 만 실패한다.

# ── 도메인 (가비아에서 구매한 것) ───────────────────────────────
DOMAIN=

# ── 메인 DB ─────────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=haetdeul

# ── 메인이 읽는 ML 원천 DB ──────────────────────────────────────
ML_SOURCE_DB_HOST=
ML_SOURCE_DB_PORT=5432
ML_SOURCE_DB_NAME=
ML_SOURCE_DB_USER=
ML_SOURCE_DB_PASSWORD=

# ── ML 콘솔 API 컨테이너 ────────────────────────────────────────
# ML_CONSOLE_ORIGIN 은 deploy.sh 가 http://ml-backend:8102 로 채운다.
ML_DATABASE_URL=
ML_TEST_DATABASE_URL=
ML_MODELS_DIR=/srv/haetdeul/ml-models

# ── LLM (현재 GitHub Secrets 에 있는 값을 그대로 옮긴다) ───────
LLM_ENABLED=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
MASTER_LLM_PROVIDER=
MASTER_LLM_MODEL=
CRITIC_LLM_PROVIDER=
CRITIC_LLM_TIMEOUT_SECONDS=
FINANCE_LLM_ENABLED=
FINANCE_LLM_PROVIDER=
FINANCE_LLM_MODEL=
SALES_LLM_ENABLED=
SALES_LLM_PROVIDER=
SALES_LLM_MODEL=
GEMINI_API_KEY=
MASTER_GEMINI_API_KEY=
FINANCE_GEMINI_API_KEY=
SALES_GEMINI_API_KEY=
ML_GEMINI_API_KEY=
PURCHASE_GEMINI_API_KEY=
